# Required. Your Anthropic API key — used for the LLM (grounded generation).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Auto-ingest the seed corpus on first run if the Chroma collection is empty.
# Leave as true for a clean clone / demo. Set to false only if you're deliberately
# running against a pre-populated or non-seed corpus
SEED_ON_EMPTY=true

# Optional. Overrides where Chroma stores its data. Leave unset for local
# (non-Docker) development — defaults to ./chroma_db.
# In Docker, this is set inside the image to /data/chroma_db, matching the
# named volume mount in docker-compose.yml. Do NOT set CHROMA_PATH here —
# docker-compose.yml loads this file via env_file, so a value set here
# silently overrides the Dockerfile default and writes Chroma data outside
# the mounted volume, breaking persistence across `docker compose restart`.
# CHROMA_PATH=