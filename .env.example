# LLM provider [anthropic | ollama]. Default: anthropic.
LLM_PROVIDER=anthropic

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Required for the default setup (LLM_PROVIDER=anthropic).
# Keep real credentials out of version control.
# Create a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Ollama (optional local alternative — no API key needed)
# Only used when LLM_PROVIDER=ollama. See the README's "Appendix: Local LLM
# with Ollama" for the full walkthrough.
# ---------------------------------------------------------------------------
# Matches `docker compose --profile ollama up --build` (see README).
OLLAMA_BASE_URL=http://ollama:11434

# Other ways of running Ollama need a different value instead:
# - Host dev, Ollama installed locally:      http://localhost:11434
# - Manual two-container setup (README):     http://<container name>:11434

# ---------------------------------------------------------------------------
# Seed corpus
# ---------------------------------------------------------------------------
# Auto-ingest the seed corpus on first run if the Chroma collection is empty.
#
# Docker pins this to true in docker-compose.yml, overriding this value.
# For host development against the full corpus, set this to false.
# See "Develop and evaluate (host)" in the README.
SEED_ON_EMPTY=true

# ---------------------------------------------------------------------------
# Chroma
# ---------------------------------------------------------------------------
# Override where Chroma stores its data.
#
# For local development, leave unset; the default is ./chroma_db.
# Docker pins this to /data/chroma_db in docker-compose.yml, so a value
# specified here does not affect the container.
# CHROMA_PATH=

# Traces are created locally; network export is disabled by default.
# Set to otlp to enable OTLP/gRPC export (HTTP/protobuf is not supported).
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=2
