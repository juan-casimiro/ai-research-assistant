# LLM provider [anthropic | ollama]. Default: ollama.
LLM_PROVIDER=ollama

# Model for the selected provider. Recommended defaults:
# ollama: smollm2:1.7b-instruct-q4_K_M
# anthropic: claude-haiku-4-5-20251001
# Unset uses the selected provider's default; if set, update when switching providers.
# LLM_MODEL=smollm2:1.7b-instruct-q4_K_M

# Ollama settings — used only when LLM_PROVIDER=ollama.
# Inside Docker, use the Ollama container name on a shared network, not localhost.
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic settings — used only when LLM_PROVIDER=anthropic.
# Required only for Anthropic. Keep real credentials out of version control.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Auto-ingest the seed corpus on first run if the Chroma collection is empty.
# Docker always runs with this true (pinned in docker-compose.yml, overrides
# whatever is set here). For host development against the full corpus, set
# this to false — see "Develop and evaluate (host)" in the README.
SEED_ON_EMPTY=true

# Optional. Overrides where Chroma stores its data. Leave unset for local
# (non-Docker) development — defaults to ./chroma_db. Docker always pins
# this to /data/chroma_db (matching the named volume in docker-compose.yml),
# so a value set here has no effect on the container.
# CHROMA_PATH=
