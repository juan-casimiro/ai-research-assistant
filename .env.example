# Required. Your Anthropic API key — used for the LLM (grounded generation).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Auto-ingest the seed corpus on first run if the Chroma collection is empty.
# Docker always runs with this true (pinned in docker-compose.yml, overrides
# whatever is set here). For host development against the full corpus, set
# this to false — see "Develop and evaluate (host)" in the README.
SEED_ON_EMPTY=true

# Optional. Overrides where Chroma stores its data. Leave unset for local
# (non-Docker) development — defaults to ./chroma_db. Docker always pins
# this to /data/chroma_db (matching the named volume in docker-compose.yml),
# so a value set here has no effect on the container.
# CHROMA_PATH=