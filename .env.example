# Required. Your Anthropic API key — used for the LLM (grounded generation).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Auto-ingest the seed corpus on first run if the Chroma collection is empty.
# Leave as true for a clean clone / demo. Set to false only if you're deliberately
# running against a pre-populated or non-seed corpus
SEED_ON_EMPTY=true