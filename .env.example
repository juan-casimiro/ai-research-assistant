# LLM provider [anthropic | ollama]. Default: ollama.
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Ollama
# Used only when LLM_PROVIDER=ollama.
# ---------------------------------------------------------------------------
# For local development:
OLLAMA_BASE_URL=http://localhost:11434

# Inside Docker, use the Ollama container/service name on the shared network
# rather than localhost:
# - One-command profile (docker compose --profile ollama up --build):
#   OLLAMA_BASE_URL=http://ollama:11434
# - Manual two-container setup (see README's "Local LLM with Ollama"
#   walkthrough): use the container name you chose, e.g.
#   OLLAMA_BASE_URL=http://rag-ollama:11434

# ---------------------------------------------------------------------------
# Anthropic
# Used only when LLM_PROVIDER=anthropic.
# ---------------------------------------------------------------------------
# Required only for Anthropic.
# Keep real credentials out of version control.
# Create a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Seed corpus
# ---------------------------------------------------------------------------
# Auto-ingest the seed corpus on first run if the Chroma collection is empty.
#
# Docker pins this to true in docker-compose.yml, overriding this value.
# For host development against the full corpus, set this to false.
# See "Develop and evaluate (host)" in the README.
SEED_ON_EMPTY=true

# ---------------------------------------------------------------------------
# Chroma
# ---------------------------------------------------------------------------
# Override where Chroma stores its data.
#
# For local development, leave unset; the default is ./chroma_db.
# Docker pins this to /data/chroma_db in docker-compose.yml, so a value
# specified here does not affect the container.
# CHROMA_PATH=
