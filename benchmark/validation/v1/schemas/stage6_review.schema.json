{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "agreement",
    "own_verdict",
    "own_severity",
    "gold_stands",
    "evidence",
    "rationale",
    "correction_assessment"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "agreement": {
      "type": "string",
      "enum": [
        "agree",
        "partly_agree",
        "disagree"
      ]
    },
    "own_verdict": {
      "type": "string",
      "enum": [
        "valid",
        "valid_minor",
        "defect_gold",
        "defect_anchor",
        "defect_category",
        "ambiguous_question",
        "alternative_missing",
        "absence_violated",
        "premise_not_false",
        "decoy_invalid",
        "needs_pdf_check"
      ]
    },
    "own_severity": {
      "type": "string",
      "enum": [
        "none",
        "non_blocking",
        "blocking"
      ]
    },
    "gold_stands": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "quote",
          "point"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "point": {
            "type": "string"
          }
        }
      }
    },
    "rationale": {
      "type": "string"
    },
    "correction_assessment": {
      "type": "string"
    }
  }
}
