          "quote": {
            "type": "string"
          },
          "point": {
            "type": "string"
          }
        }
      }
    },
    "rationale": {
      "type": "string"
    },
    "proposed_correction": {
      "type": "string"
    },
    "blind_answer_assessment": {
      "type": "string"
    },
    "hunter_assessment": {
      "type": "string"
    }
