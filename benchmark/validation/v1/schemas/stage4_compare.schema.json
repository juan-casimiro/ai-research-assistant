{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "cases"
  ],
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "answerability_agrees",
          "facts",
          "different_source",
          "blind_reported_ambiguity",
          "ambiguity_changes_answer",
          "escalate",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "answerability_agrees": {
            "type": "boolean"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact_id",
                "result",
                "note"
              ],
              "properties": {
                "fact_id": {
                  "type": "string"
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "match",
                    "partial",
                    "mismatch",
                    "not_addressed"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "different_source": {
            "type": "boolean"
          },
          "blind_reported_ambiguity": {
            "type": "boolean"
          },
          "ambiguity_changes_answer": {
            "type": "boolean"
          },
          "escalate": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
